POSTGRES_USER=sanket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sanket

DATABASE_URL=postgresql+psycopg://sanket:changeme@127.0.0.1:5433/sanket

# development, test or production. The container images set production, and production refuses
# the development shortcuts: with AUTH_DEV_BYPASS on, no process starts (docs/deploy.md).
ENVIRONMENT=development

# Ingestion
# Comma-separated source names to run. Empty runs all of them. Locally, leave out
# remotive: its 4 requests a day belong to the scheduled production job.
# Also available: ashby (needs ASHBY_BOARDS), jobtech_se (Swedish public job ads) and
# usajobs (needs USAJOBS_API_KEY and USAJOBS_USER_AGENT_EMAIL, skipped without them).
INGEST_SOURCES=remoteok,weworkremotely,jobicy,himalayas,greenhouse,lever,ashby
# Public Greenhouse board tokens and Lever company slugs (all verified live 2026-11-12).
GREENHOUSE_BOARDS=gitlab,airbnb,stripe,cloudflare,datadog,figma,coinbase,reddit,mongodb,elastic
LEVER_COMPANIES=palantir,spotify,zoox,matchgroup,outreach
# Public Ashby job board names (the part after jobs.ashbyhq.com/). Empty fetches nothing.
ASHBY_BOARDS=ashby
# JobTech Sweden (Swedish public job ads, no key): optional search words, pages of 100 ads per
# run (at most 20) and how many days back to look. Empty query takes every ad in Sweden.
JOBTECH_QUERY=
JOBTECH_MAX_PAGES=5
JOBTECH_LOOKBACK_DAYS=2
# USAJOBS (US federal jobs): free key from developer.usajobs.gov and the email address it was
# registered with. Without both, the source is skipped and makes no request.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=you@example.com
# Optional free key from himalayas.app; raises the rate limit above the shared allowance.
HIMALAYAS_API_KEY=

# Group postings into canonical jobs at the end of every ingest run. Failures are logged and
# never fail the run. Set to false until the job table has been migrated.
CANONICALISE_AFTER_INGEST=true

# LLM extraction (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=15
# Cost guards: postings per run, description length sent to the model, runs per posting.
EXTRACTION_BATCH_LIMIT=50
EXTRACTION_MAX_DESCRIPTION_CHARS=12000
EXTRACTION_MAX_ATTEMPTS=3
# The run fails when provider errors exceed this share (0 to 1) of the postings it tried, or
# when it stops early after repeated errors. Fewer errors than that only log a warning.
EXTRACTION_MAX_PROVIDER_ERROR_RATIO=0.2
# Sources never sent to the model. Remote OK reserves AI training on its data.
EXTRACTION_EXCLUDED_SOURCES=remoteok
# Index a job again (full-text vector, embedding) as soon as its representative posting is
# extracted. Needs GEMINI_API_KEY; matching is queued as after an indexing run.
INDEX_AFTER_EXTRACTION=true
# Backlog runs (python -m sanket.extract_backfill): postings sent per minute, and per UTC day
# (counted in Redis, so a restarted run respects it). Keep both under the key's quota.
EXTRACT_BACKFILL_RPM=10
EXTRACT_BACKFILL_DAILY_CAP=500
# A backlog run stops before its estimated cost passes this cap (USD). The estimate uses the
# model's price per million tokens (standard tier of gemini-3.5-flash-lite; output includes
# thinking tokens).
EXTRACT_BACKFILL_MAX_COST_USD=5
EXTRACTION_INPUT_USD_PER_MTOK=0.30
EXTRACTION_OUTPUT_USD_PER_MTOK=2.50

# Indexing (full-text vector and embeddings), run with `python -m sanket.indexing --apply`.
# The vector column is 768 dimensions; EMBEDDING_DIMENSIONS must match it. The embedding
# model reuses GEMINI_API_KEY. Pacing and batch size should stay under the key's quota.
EMBEDDING_MODEL=gemini-embedding-001
# Label for the (model, settings) combination; changing it embeds every job again.
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=768
EMBEDDING_REQUESTS_PER_MINUTE=30
EMBEDDING_BATCH_SIZE=20
# Jobs needing work handled per run, and the description excerpt length (characters).
INDEXING_BATCH_LIMIT=500
INDEXING_MAX_DESCRIPTION_CHARS=3000
# pgvector hnsw.ef_search: candidates examined per vector query (1 to 1000).
HNSW_EF_SEARCH=100

# Search API (python -m sanket.api). Binds to loopback unless you change API_HOST.
API_HOST=127.0.0.1
API_PORT=8000
# Candidates per ranked list before fusion (also the deepest page reachable), the RRF k, and
# the per-list fusion weights.
SEARCH_CANDIDATES=100
SEARCH_RRF_K=60
SEARCH_FULLTEXT_WEIGHT=1.0
SEARCH_VECTOR_WEIGHT=1.0
# Query embeddings kept in process (0 turns the cache off); seconds to wait for the embedding
# provider before answering from full text only.
SEARCH_QUERY_CACHE_SIZE=1000
SEARCH_EMBEDDING_TIMEOUT_SECONDS=5

# Task queue (Redis, RQ). Leave REDIS_URL empty to run without a queue: profiles are still
# saved and indexing still works, and pending matching is picked up by
# `python -m sanket.matching` (docs/matching.md). Start the local Redis with
# `docker compose up -d redis`.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=sanket
# Attempts per task in total, then the retry delay: base * factor ** (retry - 1), capped.
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_BASE_SECONDS=30
QUEUE_BACKOFF_FACTOR=2
QUEUE_BACKOFF_MAX_SECONDS=3600
QUEUE_TASK_TIMEOUT_SECONDS=600
QUEUE_DEAD_LETTER_TTL_DAYS=30
REDIS_TIMEOUT_SECONDS=3

# Worker visibility (docs/adr/0011-worker-visibility.md). A running worker refreshes a heartbeat
# key in Redis every WORKER_HEARTBEAT_INTERVAL_SECONDS (more than 0, at most 300); the key
# expires after WORKER_HEARTBEAT_TTL_SECONDS (3 to 3600, and at least 3 times the interval), so a
# dead or hung worker drops out of sanket_worker_up on /metrics and fails the container health
# check. WORKER_NAME names this worker's key; leave it empty to use the host name (the container
# id in Docker). Two workers must not share a name.
WORKER_NAME=
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=45

# Profiles and matching (docs/adr/0006-profiles-and-matching.md, docs/matching.md).
# The owner id that requests act as when AUTH_DEV_BYPASS is on (see Authentication below).
DEFAULT_OWNER_ID=default
MAX_PROFILES_PER_OWNER=20
# Queue a matching task for each job whose embedding changed in an indexing run
# (needs REDIS_URL).
MATCH_ENQUEUE_AFTER_INDEXING=true
# A match needs this blended score (0 to 1) and this embedding cosine similarity. The cosine
# part of the score is rescaled from MATCH_MIN_COSINE (0) to 1 (1). Untuned starting values.
MATCH_MIN_SCORE=0.55
MATCH_MIN_COSINE=0.5
# Weights of the score parts; parts that do not apply to a profile are left out and the rest
# renormalised.
MATCH_WEIGHT_COSINE=0.6
MATCH_WEIGHT_SKILLS=0.25
MATCH_WEIGHT_TITLE=0.15
# Share of a profile's required skills a job must list (1 means all of them).
MATCH_REQUIRED_SKILLS_MIN_FRACTION=1.0
# Nearest profiles examined per changed job, and jobs examined per changed profile (jobs seen
# in the last MATCH_RECENT_JOB_DAYS days).
MATCH_MAX_PROFILES_PER_JOB=200
MATCH_RECENT_JOB_DAYS=30
MATCH_MAX_JOBS_PER_PROFILE=200

# Live match feed (docs/adr/0007-live-match-feed.md, docs/feed.md). Matches are published to
# Redis per profile and streamed over Server-Sent Events; without REDIS_URL streams poll the
# database instead.
FEED_CHANNEL_PREFIX=sanket:matches
FEED_HEARTBEAT_SECONDS=15
FEED_RETRY_MS=3000
FEED_REPLAY_BATCH_SIZE=100
FEED_BUFFER_SIZE=100
FEED_MAX_STREAMS=200
FEED_MAX_STREAMS_PER_PROFILE=5
FEED_DB_POLL_SECONDS=5
FEED_MAX_STREAM_SECONDS=3600

# Authentication (docs/adr/0008-authentication.md). The API needs at least one of the three
# credential types below, or AUTH_DEV_BYPASS=true in development or test, to start.
# Local development: requests without credentials act as DEFAULT_OWNER_ID. With
# ENVIRONMENT=production the settings refuse to load while this is on, in every process, so
# a production environment must leave it unset or false.
AUTH_DEV_BYPASS=true
# JWTs signed with this shared secret (HS256, at least 32 characters), and/or by an identity
# provider whose public keys are published at an https JWKS URL (RS256, ES256).
AUTH_JWT_SECRET=
AUTH_JWKS_URL=
# Checked when set: the token issuer and audience; the claim that names the owner; a scope the
# token must carry (a valid token without it is answered 403); clock skew allowed.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_OWNER_CLAIM=sub
AUTH_REQUIRED_SCOPE=
AUTH_LEEWAY_SECONDS=30
# Static keys for services: owner=key pairs separated by commas. Prefer storing only the digest,
# owner=sha256:<64 hex>: `python -m sanket.auth` makes a key and prints its entry. A plain
# key must be at least 24 random characters.
AUTH_API_KEYS=
# Signs the one-minute tokens that open the match stream from a browser EventSource. Unset
# disables them.
AUTH_STREAM_TOKEN_SECRET=
AUTH_STREAM_TOKEN_TTL_SECONDS=60
# Let GET /search be called without credentials (it costs an embedding call per query).
SEARCH_PUBLIC=false

# Logging: DEBUG, INFO, WARNING or ERROR; json (one object per line, for containers and log
# shippers) or text. Left empty, the format is text in development and json elsewhere. Every
# line of an API request carries its request id (the X-Request-ID header, made if absent).
LOG_LEVEL=INFO
LOG_FORMAT=

# Rate limiting (docs/adr/0009-rate-limiting.md): requests per window for each caller (the
# owner, or the client address when not authenticated). Redis-backed when REDIS_URL is set.
# Streaming requests are not counted. TRUSTED_PROXY_HOPS is the number of reverse proxies that
# append to X-Forwarded-For in front of the API; keep 0 unless you run behind such proxies.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_SEARCH_REQUESTS=30
TRUSTED_PROXY_HOPS=0

# Probes and metrics. /healthz is liveness only; /readyz checks the database, Redis when
# REDIS_URL is set, and with READYZ_CHECK_MIGRATIONS=true that the schema is at the head this
# code expects. /metrics needs METRICS_TOKEN as a bearer token when set (generate one like an
# API key); with no token it is served in development and answers 404 in production.
READYZ_TIMEOUT_SECONDS=2
READYZ_CHECK_MIGRATIONS=false
METRICS_ENABLED=true
METRICS_TOKEN=

# Tracing (OpenTelemetry, optional: pip install "sanket[otel]"). Off unless an OTLP/HTTP
# endpoint is set, for example http://localhost:4318 (the collector in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sanket-api
OTEL_SAMPLE_RATIO=1.0

# Docker Compose (docs/deploy.md). `docker compose up -d --build api worker` runs migrate, the
# api and the worker against the compose db and redis (their URLs are set by the compose file).
# Inside the containers ENVIRONMENT defaults to production, so set the AUTH_* values above (and
# no AUTH_DEV_BYPASS) or keep ENVIRONMENT=development with AUTH_DEV_BYPASS=true. Host ports (all bound to localhost):
#   API_HOST_PORT=8000  DB_PORT=5433  REDIS_PORT=6379
# Build the image with tracing support: WITH_OTEL=true. The observability profile
# (prometheus, grafana, otel-collector) is started with --profile observability.
GRAFANA_ADMIN_PASSWORD=
