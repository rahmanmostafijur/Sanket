POSTGRES_USER=sanket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sanket

DATABASE_URL=postgresql+psycopg://sanket:changeme@127.0.0.1:5433/sanket

# development, test or production. Production refuses the development shortcuts (such as
# AUTH_DEV_BYPASS) and the container images set it; see docs/deploy.md.
ENVIRONMENT=development

# Ingestion
# Comma-separated source names to run. Empty runs all of them. Locally, leave out
# remotive: its 4 requests a day belong to the scheduled production job.
# Also available: ashby (needs ASHBY_BOARDS), jobtech_se (Swedish public job ads) and
# usajobs (needs USAJOBS_API_KEY and USAJOBS_USER_AGENT_EMAIL, skipped without them).
INGEST_SOURCES=remoteok,weworkremotely,jobicy,himalayas,greenhouse,lever,ashby
# Public Greenhouse board tokens and Lever company slugs (all verified live 2026-11-12).
GREENHOUSE_BOARDS=gitlab,airbnb,stripe,cloudflare,datadog,figma,coinbase,reddit,mongodb,elastic
LEVER_COMPANIES=palantir,spotify,zoox,matchgroup,outreach
# Public Ashby job board names (the part after jobs.ashbyhq.com/). Empty fetches nothing.
ASHBY_BOARDS=ashby
# JobTech Sweden (Swedish public job ads, no key): optional search words, pages of 100 ads per
# run (at most 20) and how many days back to look. Empty query takes every ad in Sweden.
JOBTECH_QUERY=
JOBTECH_MAX_PAGES=5
JOBTECH_LOOKBACK_DAYS=2
# USAJOBS (US federal jobs): free key from developer.usajobs.gov and the email address it was
# registered with. Without both, the source is skipped and makes no request.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=you@example.com
# Optional free key from himalayas.app; raises the rate limit above the shared allowance.
HIMALAYAS_API_KEY=

# Group postings into canonical jobs at the end of every ingest run. Failures are logged and
# never fail the run. Set to false until the job table has been migrated.
CANONICALISE_AFTER_INGEST=true

# LLM extraction (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=15
# Cost guards: postings per run, description length sent to the model, runs per posting.
EXTRACTION_BATCH_LIMIT=50
EXTRACTION_MAX_DESCRIPTION_CHARS=12000
EXTRACTION_MAX_ATTEMPTS=3
# Sources never sent to the model. Remote OK reserves AI training on its data.
EXTRACTION_EXCLUDED_SOURCES=remoteok

# Indexing (full-text vector and embeddings), run with `python -m sanket.indexing --apply`.
# The vector column is 768 dimensions; EMBEDDING_DIMENSIONS must match it. The embedding
# model reuses GEMINI_API_KEY. Pacing and batch size should stay under the key's quota.
EMBEDDING_MODEL=gemini-embedding-001
# Label for the (model, settings) combination; changing it embeds every job again.
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=768
EMBEDDING_REQUESTS_PER_MINUTE=30
EMBEDDING_BATCH_SIZE=20
# Jobs needing work handled per run, and the description excerpt length (characters).
INDEXING_BATCH_LIMIT=500
INDEXING_MAX_DESCRIPTION_CHARS=3000
# pgvector hnsw.ef_search: candidates examined per vector query (1 to 1000).
HNSW_EF_SEARCH=100

# Search API (python -m sanket.api). Binds to loopback unless you change API_HOST.
API_HOST=127.0.0.1
API_PORT=8000
# Candidates per ranked list before fusion (also the deepest page reachable), the RRF k, and
# the per-list fusion weights.
SEARCH_CANDIDATES=100
SEARCH_RRF_K=60
SEARCH_FULLTEXT_WEIGHT=1.0
SEARCH_VECTOR_WEIGHT=1.0
# Query embeddings kept in process (0 turns the cache off); seconds to wait for the embedding
# provider before answering from full text only.
SEARCH_QUERY_CACHE_SIZE=1000
SEARCH_EMBEDDING_TIMEOUT_SECONDS=5

# Task queue (Redis, RQ). Leave REDIS_URL empty to run without a queue: profiles are still
# saved and indexing still works, and pending matching is picked up by
# `python -m sanket.matching` (docs/matching.md). Start the local Redis with
# `docker compose up -d redis`.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=sanket
# Attempts per task in total, then the retry delay: base * factor ** (retry - 1), capped.
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_BASE_SECONDS=30
QUEUE_BACKOFF_FACTOR=2
QUEUE_BACKOFF_MAX_SECONDS=3600
QUEUE_TASK_TIMEOUT_SECONDS=600
QUEUE_DEAD_LETTER_TTL_DAYS=30
REDIS_TIMEOUT_SECONDS=3

# Profiles and matching (docs/adr/0006-profiles-and-matching.md, docs/matching.md).
# Every request acts as this owner until authentication exists.
DEFAULT_OWNER_ID=default
MAX_PROFILES_PER_OWNER=20
# Queue a matching task for each job whose embedding changed in an indexing run
# (needs REDIS_URL).
MATCH_ENQUEUE_AFTER_INDEXING=true
# A match needs this blended score (0 to 1) and this embedding cosine similarity. The cosine
# part of the score is rescaled from MATCH_MIN_COSINE (0) to 1 (1). Untuned starting values.
MATCH_MIN_SCORE=0.55
MATCH_MIN_COSINE=0.5
# Weights of the score parts; parts that do not apply to a profile are left out and the rest
# renormalised.
MATCH_WEIGHT_COSINE=0.6
MATCH_WEIGHT_SKILLS=0.25
MATCH_WEIGHT_TITLE=0.15
# Share of a profile's required skills a job must list (1 means all of them).
MATCH_REQUIRED_SKILLS_MIN_FRACTION=1.0
# Nearest profiles examined per changed job, and jobs examined per changed profile (jobs seen
# in the last MATCH_RECENT_JOB_DAYS days).
MATCH_MAX_PROFILES_PER_JOB=200
MATCH_RECENT_JOB_DAYS=30
MATCH_MAX_JOBS_PER_PROFILE=200
