POSTGRES_USER=sanket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sanket

DATABASE_URL=postgresql+psycopg://sanket:changeme@127.0.0.1:5433/sanket

# Ingestion
# Comma-separated source names to run. Empty runs all of them. Locally, leave out
# remotive: its 4 requests a day belong to the scheduled production job.
# Also available: ashby (needs ASHBY_BOARDS), jobtech_se (Swedish public job ads) and
# usajobs (needs USAJOBS_API_KEY and USAJOBS_USER_AGENT_EMAIL, skipped without them).
INGEST_SOURCES=remoteok,weworkremotely,jobicy,himalayas,greenhouse,lever,ashby
# Public Greenhouse board tokens and Lever company slugs (all verified live 2026-11-12).
GREENHOUSE_BOARDS=gitlab,airbnb,stripe,cloudflare,datadog,figma,coinbase,reddit,mongodb,elastic
LEVER_COMPANIES=palantir,spotify,zoox,matchgroup,outreach
# Public Ashby job board names (the part after jobs.ashbyhq.com/). Empty fetches nothing.
ASHBY_BOARDS=ashby
# JobTech Sweden (Swedish public job ads, no key): optional search words, pages of 100 ads per
# run (at most 20) and how many days back to look. Empty query takes every ad in Sweden.
JOBTECH_QUERY=
JOBTECH_MAX_PAGES=5
JOBTECH_LOOKBACK_DAYS=2
# USAJOBS (US federal jobs): free key from developer.usajobs.gov and the email address it was
# registered with. Without both, the source is skipped and makes no request.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=you@example.com
# Optional free key from himalayas.app; raises the rate limit above the shared allowance.
HIMALAYAS_API_KEY=

# Group postings into canonical jobs at the end of every ingest run. Failures are logged and
# never fail the run. Set to false until the job table has been migrated.
CANONICALISE_AFTER_INGEST=true

# LLM extraction (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=15
# Cost guards: postings per run, description length sent to the model, runs per posting.
EXTRACTION_BATCH_LIMIT=50
EXTRACTION_MAX_DESCRIPTION_CHARS=12000
EXTRACTION_MAX_ATTEMPTS=3
# Sources never sent to the model. Remote OK reserves AI training on its data.
EXTRACTION_EXCLUDED_SOURCES=remoteok
