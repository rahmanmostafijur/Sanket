POSTGRES_USER=sanket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sanket

DATABASE_URL=postgresql+psycopg://sanket:changeme@127.0.0.1:5433/sanket

# Ingestion
# Comma-separated source names to run. Empty runs all of them. Locally, leave out
# remotive: its 4 requests a day belong to the scheduled production job.
INGEST_SOURCES=remoteok,weworkremotely,jobicy,himalayas,greenhouse,lever
# Public Greenhouse board tokens and Lever company slugs (all verified live 2026-11-12).
GREENHOUSE_BOARDS=gitlab,airbnb,stripe,cloudflare,datadog,figma,coinbase,reddit,mongodb,elastic
LEVER_COMPANIES=palantir,spotify,zoox,matchgroup,outreach
# Optional free key from himalayas.app; raises the rate limit above the shared allowance.
HIMALAYAS_API_KEY=

# LLM extraction (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=15
# Cost guards: postings per run, description length sent to the model, runs per posting.
EXTRACTION_BATCH_LIMIT=50
EXTRACTION_MAX_DESCRIPTION_CHARS=12000
EXTRACTION_MAX_ATTEMPTS=3
# Sources never sent to the model. Remote OK reserves AI training on its data.
EXTRACTION_EXCLUDED_SOURCES=remoteok
